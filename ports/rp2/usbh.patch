--- usbh.c	(TinyUSB 0.21.0-micropython1, lib/tinyusb)
+++ usbh.c	(Pico Computer 3 MicroPython, ports/rp2/usbh.patch)
@@ -237,6 +237,31 @@
 static uint8_t _usbh_controller_id = TUSB_INDEX_INVALID_8;
 static usbh_data_t _usbh_data;
 
+/* PC3: enumeration-exclusive control dispatch (ports/rp2/usbh.patch).  While
+ * a device is being enumerated, only control transfers to address 0, to the
+ * address being enumerated (the driver-open phase) and to the hub in use may
+ * claim the single control slot; application control traffic - a keyboard
+ * LED write, a touch handshake - waits in the pending FIFO until the
+ * enumeration completes.  This restores 0.20's effectively-atomic
+ * enumeration and keeps the shared EPX state undisturbed mid-bring-up.
+ * Validated on the PicoMite tinyusb-0.21 tree on this hardware. */
+static inline bool ctrl_blocked_by_enum(uint8_t daddr) {
+  return (_usbh_data.enumerating_daddr != TUSB_INDEX_INVALID_8) &&
+         (daddr != 0) &&
+         (daddr != _usbh_data.enumerating_daddr) &&
+         (daddr != _usbh_data.dev0_bus.hub_addr);
+}
+
+/* True when the pending-control FIFO has a head entry that may be dispatched
+ * now.  Peek, not read: a blocked head stays queued for after enumeration. */
+static bool pending_ctrl_dispatchable(void) {
+  usbh_pending_ctrl_t head;
+  if (tu_fifo_peek_n(&_usbh_pending_ctrl_q, &head, sizeof(head)) != sizeof(head)) {
+    return false;
+  }
+  return !ctrl_blocked_by_enum(head.daddr);
+}
+
 typedef struct {
   TUH_EPBUF_TYPE_DEF(tusb_control_request_t, request);
   TUH_EPBUF_DEF(ctrl, CFG_TUH_ENUMERATION_BUFSIZE);
@@ -674,9 +699,10 @@
   }
   #endif
 

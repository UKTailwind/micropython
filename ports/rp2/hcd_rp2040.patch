--- hcd_rp2040.c	(TinyUSB 0.21.0-micropython1, lib/tinyusb)
+++ hcd_rp2040.c	(Pico Computer 3 MicroPython, ports/rp2/hcd_rp2040.patch)
@@ -232,9 +232,16 @@
 //--------------------------------------------------------------------+
 // Interrupt handlers
 //--------------------------------------------------------------------+
+#ifdef PC3_USB_EVLOG
+void pc3_evlog_add(uint32_t tag, uint32_t a, uint32_t b, uint32_t c); /* rp2040_usb.c (patched) */
+#endif
+
 static void __tusb_irq_path_func(xfer_complete_isr)(hw_endpoint_t *ep, xfer_result_t xfer_result, bool is_more) {
   // Mark transfer as done before we tell the tinyusb stack
   uint32_t xferred_len = ep->xferred_len;
+#ifdef PC3_USB_EVLOG
+  pc3_evlog_add('X', ep->ep_addr | ((uint32_t)ep->dev_addr << 8), xfer_result, xferred_len);
+#endif
   rp2usb_reset_transfer(ep);
   hcd_event_xfer_complete(ep->dev_addr, ep->ep_addr, xferred_len, xfer_result, true);
 
@@ -303,6 +310,9 @@
 
 static void __tusb_irq_path_func(hcd_rp2040_irq)(void) {
   const uint32_t status = usb_hw->ints;
+#ifdef PC3_USB_EVLOG
+  pc3_evlog_add('I', status, usb_hw->sie_status, usb_hw->buf_status);
+#endif
 
   if (status & USB_INTS_HOST_CONN_DIS_BITS) {
     uint8_t speed = dev_speed();
@@ -334,6 +344,14 @@
     // Even if STOP_TRANS bit is clear, controller maybe in middle of retrying and may re-raise timeout once extra time
     // Only handle if epx is active, don't carry more epx transfer since STOP_TRANS is raced and not safe.
     if (epx->state == EPSTATE_ACTIVE) {
+      /* PC3: the stopped transfer's buffer is still armed (AVAIL set) -
+       * the controller never completed it.  Left there, the next EPX
+       * transfer - usbh's retry of this very request - is refused by
+       * bufctrl_write32 with "buf_ctrl already available", which is a
+       * panic.  epx_save_context() clears it for the switch case; do
+       * the same for the failure case.  Seen at every boot on an
+       * RP2350 host behind a hub (a status-stage IN timing out). */
+      usbh_dpram->epx_buf_ctrl = 0;
       xfer_complete_isr(epx, XFER_RESULT_FAILED, false);
     }
   }

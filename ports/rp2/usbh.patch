     (void) osal_mutex_lock(_usbh_mutex, OSAL_TIMEOUT_WAIT_FOREVER);
-    if (ctrl_info->stage == CONTROL_STAGE_IDLE) {
+    // PC3: an enumeration in progress owns the slot for its own addresses
+    // (ctrl_blocked_by_enum); other traffic queues (async) or re-loops (sync,
+    // which drives tuh_task_ext below, so the enumeration still progresses).
+    if (ctrl_info->stage == CONTROL_STAGE_IDLE && !ctrl_blocked_by_enum(daddr)) {
       ctrl_info->stage        = CONTROL_STAGE_SETUP;
       ctrl_info->daddr        = daddr;
       ctrl_info->actual_len   = 0;
@@ -1024,6 +1053,7 @@
 

/* Defines/overrides the following symbols for use by code:
    __GcHeapStart, __GcHeapEnd
    __StackLimit
    __StackBottom
*/

SECTIONS
{
    /* Change for MicroPython: __StackLimit is historically the maximum heap
       pointer, i.e. the end of the C heap. */
    __StackLimit = __bss_end__ + __micropy_c_heap_size__;

    /* Define start and end of the GC heap. Reserve __micropy_extra_stack__ at
       the top of RAM for the C stack. */
    __GcHeapStart = __StackLimit; /* after the C heap (sbrk limit) */
    __GcHeapEnd = ORIGIN(RAM) + LENGTH(RAM) - __micropy_extra_stack__;

    /* Change for MicroPython: expand the C stack down to __GcHeapEnd. */
    __StackBottom = __GcHeapEnd;

    /* Check GC heap is at least 56 KB. Upstream uses 64 KB (half the minimum RAM
       suggested for full-featured MicroPython). Lowered here for the
       PICO_COMPUTER_3 fork: this board's real heap is the 8 MB PSRAM added at
       runtime via gc_add(), so the SRAM arena is only a small primary/spill
       block. Its ~300 KB HDMI framebuffer + audio buffers (static BSS, in fast
       SRAM by design) leave the SRAM GC arena just under 64 KB, and baking in
       usqlite (SQLite, ~7 KB static) tipped it 444 bytes short. 56 KB keeps a
       safe SRAM arena while allowing large static buffers in user C modules. */
    ASSERT((__GcHeapEnd - __GcHeapStart) > 56*1024, "GcHeap is too small")
}
